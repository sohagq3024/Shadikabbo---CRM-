modules = ["nodejs-20", "web", "python-base-3.13"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Shadikabbo CRM"

[[workflows.workflow]]
name = "Shadikabbo CRM"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "DISABLE_HMR=true PORT=5000 npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5057
externalPort = 3003

[[ports]]
localPort = 5177
externalPort = 3000

[[ports]]
localPort = 24678
externalPort = 3001

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-lc", "NODE_ENV=production PORT=5000 npm run start"]
build = ["npm", "run", "build"]

[objectStorage]
defaultBucketID = "replit-objstore-d7ed63d2-949c-4968-9f4f-a1bf27c1ff8f"

[userenv]

[userenv.production]
CRM_INSTANCE_ID = "ab4419c7-6ec5-46a7-a6f2-b553164a63f0"
